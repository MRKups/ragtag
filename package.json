{
  "name": "ragtag",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental local-first desktop RAG application for querying documents with source and page citations.",
  "engines": {
    "node": ">=24 <25"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "check": "npm run check --prefix frontend",
    "check:release": "node scripts/check-release.mjs",
    "licenses:generate": "node scripts/license-inventory.mjs",
    "test:release": "node --test scripts/*.test.mjs",
    "test:errors": "npm run test:errors --prefix frontend",
    "test:state": "npm run test:state --prefix frontend",
    "test": "npm run test:release && npm run test:errors --prefix frontend && npm run test:state --prefix frontend && task test-native"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MRKups/ragtag.git"
  },
  "keywords": [
    "rag",
    "desktop",
    "tauri",
    "svelte",
    "local-ai",
    "lancedb"
  ],
  "author": "Michal Kups",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MRKups/ragtag/issues"
  },
  "homepage": "https://github.com/MRKups/ragtag#readme"
}
