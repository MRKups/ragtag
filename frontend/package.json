{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test:errors": "node --experimental-strip-types src/lib/error.test.ts && node --experimental-strip-types src/lib/stores/error-dialog.test.ts",
		"test:state": "node --experimental-strip-types src/lib/stores/query.test.ts && node --experimental-strip-types src/lib/stores/document-progress.test.ts && node --experimental-strip-types src/lib/stores/settings.test.ts",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.1"
	},
	"dependencies": {
		"@lucide/svelte": "^1.48.0",
		"@tauri-apps/api": "^2.11.1",
		"dompurify": "^3.4.16",
		"marked": "^18.0.14",
		"pdfjs-dist": "^6.3.289"
	}
}
